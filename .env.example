GEMINI_API_KEY=your_gemini_api_key_here

# Shared access code staff enter once to use the app. Leave unset in local
# dev if you don't want a login screen in your way; set it before deploying
# anywhere staff (or the internet) can reach.
SITE_PASSWORD=choose_a_shared_staff_access_code

# Optional: only needed for the "find current web articles" fallback.
# See README.md > "Live web search" for how to create these.
GOOGLE_SEARCH_API_KEY=your_google_search_api_key_here
GOOGLE_SEARCH_ENGINE_ID=your_programmable_search_engine_id_here
